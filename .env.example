# OpenAI generates the briefing content.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Resend delivers the briefing to every subscribed contact in this Segment.
RESEND_API_KEY=
RESEND_FROM=AI Model Briefing <briefing@example.com>
RESEND_SEGMENT_ID=

# Supported values: daily, weekly.
BRIEFING_MODE=daily
SOURCES_FILE=config/sources.yaml
